// Agile Retrospective - Data model
// PostgreSQL (Neon) for Vercel deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Retro {
  id           String   @id @default(uuid())
  token        String   @unique
  title        String
  date         String   // ISO date
  userId       String?  // signed-in user id (from Auth.js / Google sub)
  creatorId    String?  // anonymous client id (fallback for "my retros" when not signed in)
  columnConfig Json?    // [{ id, title, order, fixed? }]; actions always present and fixed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cards        Card[]

  @@index([creatorId])
  @@index([userId])
}

model Card {
  id        String   @id @default(uuid())
  retroId   String
  retro     Retro    @relation(fields: [retroId], references: [id], onDelete: Cascade)
  column    String   // column id from retro.columnConfig (e.g. "positive", "negative", "actions", or custom id)
  text      String   @default("")
  orderKey  String   // fractional ordering (e.g. "a", "m", "z") or numeric string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  votes     Vote[]

  @@index([retroId, column])
}

model Vote {
  id        String   @id @default(uuid())
  retroId   String
  cardId    String
  voterId   String   // anonymous client uuid; user can have multiple votes per card (up to 6 per retro total)
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, voterId])
  @@index([retroId, voterId])
}
